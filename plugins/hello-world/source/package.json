{
  "name": "@ave/plugin-hello-world",
  "version": "0.4.1",
  "description": "Ave extension — a hello_world tool and a sidebar panel that calls it, for checking extension install and dynamic UI load end to end.",
  "type": "module",
  "files": [
    "dist",
    "plugin.json"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "devDependencies": {
    "@ave/plugin-build": "file:../../../tools/plugin-build",
    "@ave/plugin-contract": "file:../../../contract",
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4"
  }
}
