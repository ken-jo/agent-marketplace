{
  "schemaVersion": 2,
  "kind": "mcp",
  "name": "github-official-mcp",
  "version": "2.0.3",
  "minAppVersion": "0.14.0",
  "displayName": "GitHub Official MCP",
  "description": "Adds GitHub's official MCP server for repository, issue, pull request, Actions, and security workflows.",
  "author": {
    "name": "GitHub",
    "url": "https://github.com/github/github-mcp-server"
  },
  "license": "MIT",
  "homepage": "https://github.com/github/github-mcp-server",
  "payload": {
    "server": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "ghcr.io/github/github-mcp-server:v2.0.3@sha256:250bc6ce70788207608ef74cef4397230ff2e8481218da74d6093e4bd9101132"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "",
        "GITHUB_READ_ONLY": "1"
      },
      "auth": "none"
    }
  }
}
