{
  "schemaVersion": 2,
  "kind": "mcp",
  "name": "youtube-mcp",
  "version": "2026.10.27",
  "minAppVersion": "0.14.0",
  "displayName": "YouTube MCP",
  "description": "Reads YouTube video, channel, playlist and transcript data through the community server. Supply a YouTube Data API v3 key through Ave's secret prompt. Transcript availability depends on the video and service. Requires Node.js 24+ and npm; runtime artifacts and dependencies are integrity-locked.",
  "author": {
    "name": "Zubeid Hendricks",
    "url": "https://github.com/ZubeidHendricks/youtube-mcp-server"
  },
  "license": "MIT",
  "homepage": "https://github.com/ZubeidHendricks/youtube-mcp-server",
  "payload": {
    "server": {
      "transport": "stdio",
      "command": "server/launch.sh",
      "auth": "api-key",
      "apiKeyEnv": "YOUTUBE_API_KEY",
      "env": {
        "MCP_TRANSPORT": "stdio",
        "AVE_CONNECTOR_DATA_DIR": "$DATA_DIR/locked-runtime",
        "AVE_CONNECTOR_ALLOW_WRITES": "false",
        "AVE_CONNECTOR_ALLOW_LOCAL_WRITES": "false"
      }
    }
  },
  "platforms": [
    "darwin",
    "linux"
  ]
}
