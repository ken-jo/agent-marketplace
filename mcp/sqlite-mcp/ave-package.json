  "payload": {
    "server": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite==2025.4.25",
        "--db-path",
        "$DATA_DIR/ave.sqlite"
      ],
      "auth": "none"
    }
  }
}
