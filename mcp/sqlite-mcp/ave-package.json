{
  "schemaVersion": 2,
  "kind": "mcp",
  "name": "sqlite-mcp",
  "version": "2025.4.26",
  "minAppVersion": "0.14.0",
  "displayName": "SQLite MCP",
  "description": "Adds the official SQLite MCP server for local database querying and analysis.",
  "author": {
    "name": "Model Context Protocol",
