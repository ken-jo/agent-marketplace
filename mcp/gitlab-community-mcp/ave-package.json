{
  "schemaVersion": 2,
  "kind": "mcp",
  "name": "gitlab-community-mcp",
  "version": "2.3.1",
  "minAppVersion": "0.14.0",
  "displayName": "GitLab Community MCP",
  "description": "Adds the community GitLab MCP server for projects, issues, merge requests and pipelines, in read-only permission mode. Needs a GitLab personal access token.",
  "author": {
    "name": "zereight",
    "url": "https://github.com/zereight/gitlab-mcp"
  },
  "license": "MIT",
  "homepage": "https://github.com/zereight/gitlab-mcp",
  "payload": {
    "server": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab@2.3.1"
      ],
      "env": {
        "GITLAB_API_URL": "https://gitlab.com/api/v4",
        "GITLAB_PERMISSION_MODE": "readonly",
        "GITLAB_DISABLE_VERSION_CHECK": "true"
      },
      "auth": "api-key",
      "apiKeyEnv": "GITLAB_PERSONAL_ACCESS_TOKEN"
    }
  }
}
